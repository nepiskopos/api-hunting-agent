# Copy this file to .env and fill in real values. .env is gitignored --
# never commit it. Every setting here is optional to set via .env EXCEPT
# LLM_BASE_URL / LLM_API_KEY, which are required (in .env, exported in your
# shell, or passed to `docker run -e` / `--env-file`) since the agent
# refuses to start without them. All other settings fall back to the
# command-line flag of the same purpose, then to the hard-coded default
# documented in README.md -- see agent/config.py for the exact precedence.

# --- LLM endpoint (required) ------------------------------------------------
LLM_BASE_URL=https://spark.cyrextech.net:8881/v1
LLM_API_KEY=replace-with-your-own-key
# Optional: pin a specific model id instead of auto-detecting from /v1/models.
LLM_MODEL=qwen36-35b-a3b

# --- Run defaults (all optional; --flags on the CLI override these) --------
# Base URL of the crAPI gateway.
CRAPI_TARGET=http://localhost:8888
# Path to the credentials JSON file (see creds.example.json).
CREDS_PATH=creds.json
# Directory to write findings.json / run.log / summary.md / report.md into.
# Must not name a path that already exists as a regular file.
OUT_DIR=.
# Hard caps (cost/loop safety, the cost/safety & logging goals). Each must be a positive integer.
MAX_STEPS=40
MAX_TOTAL_TOKENS=400000
# How many identical tool calls in a row before the next one is refused as a repeat.
# Must be a positive integer. Default is 1 (zero-tolerance): a repeat of a
# byte-identical call to this deterministic local target never yields new
# information, so the first repeat is refused before dispatch.
MAX_CONSECUTIVE_REPEATS=1
# Per-HTTP-request timeout (seconds) for calls to the crAPI target. Must be
# a finite positive number (rejects <= 0, nan, and inf).
REQUEST_TIMEOUT_SECONDS=15.0
# Bonus features (the optional/bonus features), on by default.
VERIFIER_ENABLED=true
DEDUP_ENABLED=true
